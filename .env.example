# Placeholders only — copy to .env.local and fill real values.
# NEVER commit .env.local or live credentials. See docs/SECURITY.md.

# YouCam (server-only — do NOT prefix with NEXT_PUBLIC_)
YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Mode: auto (default — live when key present, else mock) | mock | live
# live without a key fails health/boot clearly; mock/auto without key is graceful.
# YOUCAM_MODE=auto

# Public site URL for metadata / robots / sitemap (optional; defaults to production)
# NEXT_PUBLIC_SITE_URL=https://youcam-ai-commerce.vercel.app

# Optional: public base URL if using Blob-hosted selfies (leave empty for File API flow)
# BLOB_READ_WRITE_TOKEN=
